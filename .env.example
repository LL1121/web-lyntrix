# =============================================================================
# Docker Compose (y Next en local si copiás este archivo a .env)
# =============================================================================
# En el servidor, en la MISMA carpeta que docker-compose.yml:
#   cp .env.example .env
#   nano .env   # completá valores reales
#
# Compose lee el archivo `.env` del directorio del proyecto para reemplazar
# ${VARIABLE} en docker-compose.yml y pasar esas variables al contenedor.
# =============================================================================

# --- Resend (API /api/contact) ----------------------------------------------
# Clave desde https://resend.com/api-keys
RESEND_API_KEY=

# Email donde recibís los mensajes del formulario (debe ser válido en Resend)
CONTACT_EMAIL=

# --- Opcional ---------------------------------------------------------------
# Puerto interno del contenedor (el compose ya mapea 3000:3000)
# PORT=3000
