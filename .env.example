# Copiar a .env en el VPS (misma carpeta que docker-compose.yml).
# No commitear .env. Caddy llega al contenedor por el nombre web_lyntrix:3000
# en la red proxy_net. No se publican puertos en el host.

NODE_ENV=production

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Destino de los mensajes del formulario
CONTACT_EMAIL=
